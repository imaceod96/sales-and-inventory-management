{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Establecimiento Comercial",
  "version": "1.0.0",
  "identifier": "com.establecimiento.comercial.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Establecimiento Comercial · Control de Inventario y Ventas",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data:;"
    }
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "windows": {
    "webviewInstallMode": {
      "type": "offlineInstaller"
    }
  }
}
}
